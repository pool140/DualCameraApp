<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="#12121F"
    android:padding="16dp" android:layout_margin="4dp"
    android:gravity="center_vertical">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvFileName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvFileInfo" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#9CA3AF"
            android:textSize="11sp" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView android:id="@+id/tvFileType" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textStyle="bold"/>
</LinearLayout>
