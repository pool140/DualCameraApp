<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#111827"
    android:gravity="center"
    android:padding="32dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Dual Camera" android:textSize="28sp" android:textColor="#FFFFFF"
        android:textStyle="bold" android:layout_marginBottom="12dp" />
    <TextView android:id="@+id/tvStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="جاري فحص الجهاز..." android:textSize="13sp" android:textColor="#10B981"
        android:gravity="center" android:padding="12dp" android:background="#1F2937"
        android:layout_marginBottom="24dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#1F2937"
        android:padding="20dp" android:layout_marginBottom="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ارفع الصوت = ابدا التسجيل"
            android:textColor="#10B981" android:textSize="15sp" android:layout_marginBottom="10dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="اخفض الصوت = وقف وحفظ في المعرض"
            android:textColor="#EF4444" android:textSize="15sp" />
    </LinearLayout>
    <Button android:id="@+id/btnStart" android:layout_width="match_parent"
        android:layout_height="56dp" android:text="تشغيل الخدمة"
        android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
        android:backgroundTint="#10B981" android:layout_marginBottom="12dp" />
    <Button android:id="@+id/btnStop" android:layout_width="match_parent"
        android:layout_height="56dp" android:text="ايقاف الخدمة"
        android:textColor="#FFFFFF" android:backgroundTint="#374151" android:layout_marginBottom="24dp" />
    <TextView android:id="@+id/tvPath" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الفيديوهات ستظهر في معرض الصور - Movies/DualCamera"
        android:textSize="11sp" android:textColor="#6B7280" android:gravity="center" />
</LinearLayout>
